<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:IHECLibrary.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="IHECLibrary.Views.ChatbotView"
             x:DataType="vm:ChatbotViewModel">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    
    <!-- Barre de navigation -->
    <Grid Grid.Row="0" Background="{StaticResource PrimaryBrush}" Height="60">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      
      <!-- Logo and title -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
        <TextBlock Text="📚" FontSize="22" Margin="0,0,8,0" Foreground="White"/>
        <TextBlock Text="IHEC BookZone" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
      </StackPanel>
      
      <!-- Center navigation menu -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Button Content="Home" Command="{Binding NavigateToHomeCommand}" 
                Background="Transparent" Foreground="White" 
                Padding="12,8" Margin="5,0" CornerRadius="4"/>
        <Button Content="Library" Command="{Binding NavigateToLibraryCommand}" 
                Background="Transparent" Foreground="White" 
                Padding="12,8" Margin="5,0" CornerRadius="4"/>
        <Button Content="IHEC Assistant" Command="{Binding NavigateToChatbotCommand}" 
                Background="White" Foreground="{StaticResource PrimaryBrush}" 
                Padding="12,8" Margin="5,0" CornerRadius="4"/>
        <Button Content="Profile" Command="{Binding NavigateToProfileCommand}" 
                Background="Transparent" Foreground="White" 
                Padding="12,8" Margin="5,0" CornerRadius="4"/>
      </StackPanel>
      
      <!-- Right side: Search and profile -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
        <Button Content="Ask" Padding="12,5" Margin="0,0,15,0" 
                Background="White" Foreground="{StaticResource PrimaryBrush}" 
                BorderBrush="White" BorderThickness="1" CornerRadius="4"/>
        <Border CornerRadius="50" Width="32" Height="32" ClipToBounds="True" 
                Margin="0,0,8,0" Background="#F0F2F5">
          <Image Source="{Binding UserProfilePicture}" Stretch="UniformToFill"/>
        </Border>
      </StackPanel>
    </Grid>
    
    <!-- Error message display -->
    <Border Grid.Row="1" Background="#FFF3F3" Padding="20" IsVisible="{Binding HasError}" Margin="20" CornerRadius="8" BorderBrush="#FFCDD2" BorderThickness="1">
      <StackPanel>
        <TextBlock Text="Une erreur s'est produite" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" Foreground="#D32F2F"/>
        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#D32F2F" Margin="0,0,0,15"/>
        
        <!-- Action buttons with class styling -->
        <Button Content="Retourner à l'accueil" Command="{Binding NavigateToHomeCommand}" 
                Classes="primary"
                Padding="15,8" Margin="0,10,0,0"/>
      </StackPanel>
    </Border>
    
    <!-- Contenu principal -->
    <Grid Grid.Row="1" IsVisible="{Binding !HasError}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="300"/>
      </Grid.ColumnDefinitions>
      
      <!-- Chat container -->
      <Border Grid.Column="0" Background="#f0f7fd" Margin="20">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          
          <!-- Chat header -->
          <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="20,15" CornerRadius="8 8 0 0">
            <Grid ColumnDefinitions="Auto,*">
              <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border CornerRadius="20" Width="40" Height="40" ClipToBounds="True" Background="White" Margin="0,0,15,0">
                  <TextBlock Text="🤖" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Assistant IHEC BookZone" Foreground="White" FontWeight="SemiBold" FontSize="16"/>
                  <TextBlock Text="En ligne" Foreground="White" Opacity="0.8" FontSize="12"/>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>
          
          <!-- Chat messages area -->
          <Border Grid.Row="1" Background="White">
            <ScrollViewer Name="ChatScrollViewer">
              <ItemsControl ItemsSource="{Binding Messages}" Margin="20">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChatMessageViewModel">
                    <Grid Margin="0,10,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      
                      <!-- Avatar -->
                      <Border Grid.Column="0" CornerRadius="20" Width="40" Height="40" ClipToBounds="True" Margin="0,0,15,0"
                              IsVisible="{Binding IsFromBot}">
                        <Panel Background="{StaticResource PrimaryBrush}">
                          <TextBlock Text="IHEC" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                   Foreground="White" FontWeight="Bold" FontSize="14"/>
                        </Panel>
                      </Border>
                      
                      <!-- Message -->
                      <Border Grid.Column="1" Background="{Binding IsFromBot, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#e6f2f8,#ffffff'}" 
                              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                              CornerRadius="8" Padding="15"
                              HorizontalAlignment="{Binding MessageAlignment}" MaxWidth="550"
                              BoxShadow="0 1 4 0 #10000000">
                        <StackPanel>
                          <TextBlock Text="{Binding SenderName}" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{StaticResource PrimaryBrush}"/>
                          <TextBlock Text="{Binding Content}" TextWrapping="Wrap"/>
                          
                          <!-- Suggestions (uniquement pour les messages du bot) -->
                          <ItemsControl ItemsSource="{Binding Suggestions}" Margin="0,10,0,0" IsVisible="{Binding HasSuggestions}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="sys:String">
                                <Button Content="{Binding}" 
                                        Command="{Binding $parent[UserControl].((vm:ChatbotViewModel)DataContext).UseSuggestionCommand}" 
                                        CommandParameter="{Binding}"
                                        Classes="primary"
                                        Padding="10,5" Margin="0,0,10,10" CornerRadius="4"/>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          
                          <!-- Résultats de recherche (uniquement pour les messages du bot) -->
                          <ItemsControl ItemsSource="{Binding SearchResults}" Margin="0,10,0,0" IsVisible="{Binding HasSearchResults}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:BookSearchResultViewModel">
                                <Border Classes="card" Padding="10" Margin="0,5,0,5">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" ClipToBounds="True" CornerRadius="4" Width="50" Height="70" Margin="0,0,15,0">
                                      <Image Source="{Binding CoverImageUrl}" Stretch="Uniform"/>
                                    </Border>
                                    
                                    <StackPanel Grid.Column="1">
                                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                      <TextBlock Text="{Binding Author}" FontSize="12" Opacity="0.7" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    
                                    <Button Grid.Column="2" Content="Détails" Command="{Binding ViewBookCommand}" 
                                            Classes="primary"
                                            VerticalAlignment="Center" Padding="12,6" CornerRadius="4"/>
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
          
          <!-- Input area -->
          <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0" Text="{Binding CurrentMessage}" Watermark="Posez votre question..." 
                     VerticalContentAlignment="Center" Padding="15,8"/>
              
              <Button Grid.Column="1" Command="{Binding SendMessageCommand}" 
                      Classes="primary"
                      Width="40" Height="40" Margin="10,0,0,0" CornerRadius="20" Padding="0">
                <TextBlock Text="➤" FontSize="16" FontWeight="Bold"/>
              </Button>
            </Grid>
          </Border>
        </Grid>
      </Border>
      
      <!-- Sidebar info panel -->
      <Border Grid.Column="1" Background="White" Margin="0,20,20,20">
        <StackPanel Margin="20">
          <TextBlock Text="À propos de l'Assistant" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15" Foreground="{StaticResource PrimaryBrush}"/>
          
          <TextBlock TextWrapping="Wrap" Margin="0,0,0,20">
            L'assistant IHEC BookZone est un chatbot intelligent qui peut vous aider à :
          </TextBlock>
          
          <StackPanel Margin="0,0,0,20">
            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
              <TextBlock Grid.Column="0" Text="●" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,10,0"/>
              <TextBlock Grid.Column="1" Text="Trouver des livres pertinents pour vos études" TextWrapping="Wrap"/>
            </Grid>
            
            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
              <TextBlock Grid.Column="0" Text="●" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,10,0"/>
              <TextBlock Grid.Column="1" Text="Obtenir des résumés de livres" TextWrapping="Wrap"/>
            </Grid>
            
            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
              <TextBlock Grid.Column="0" Text="●" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,10,0"/>
              <TextBlock Grid.Column="1" Text="Recevoir des recommandations personnalisées" TextWrapping="Wrap"/>
            </Grid>
            
            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
              <TextBlock Grid.Column="0" Text="●" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,10,0"/>
              <TextBlock Grid.Column="1" Text="Répondre à vos questions sur les auteurs et les ouvrages" TextWrapping="Wrap"/>
            </Grid>
          </StackPanel>
          
          <TextBlock TextWrapping="Wrap" Margin="0,0,0,20">
            L'assistant s'améliore constamment pour mieux répondre à vos besoins.
          </TextBlock>
          
          <Border Background="#f0f7fd" Padding="15" CornerRadius="8" Margin="0,0,0,20">
            <StackPanel>
              <TextBlock Text="Livres Recommandés pour vous" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{StaticResource PrimaryBrush}"/>
              
              <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Behavioral Finance and Wealth Management" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="Par Michael M. Pompian" FontSize="12" Opacity="0.7"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                  <TextBlock Text="★★★★★" Foreground="{StaticResource PrimaryBrush}"/>
                </StackPanel>
              </StackPanel>
              
              <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Finance d'Entreprise" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="Par Pierre Vernimmen" FontSize="12" Opacity="0.7"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                  <TextBlock Text="★★★★☆" Foreground="{StaticResource PrimaryBrush}"/>
                </StackPanel>
              </StackPanel>
              
              <StackPanel>
                <TextBlock Text="Économétrie Financière" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="Par Christian Gouriéroux" FontSize="12" Opacity="0.7"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                  <TextBlock Text="★★★★☆" Foreground="{StaticResource PrimaryBrush}"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
          
          <Button Content="Voir plus de recommandations" 
                  Classes="primary"
                  HorizontalAlignment="Stretch" 
                  HorizontalContentAlignment="Center" 
                  Padding="15,8"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:IHECLibrary.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="IHECLibrary.Views.ProfileView"
             x:DataType="vm:ProfileViewModel">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    
    <!-- Barre de navigation -->
    <Grid Grid.Row="0" Background="{StaticResource PrimaryBrush}" Height="60">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      
      <!-- Logo and title -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
        <TextBlock Text="📚" FontSize="22" Margin="0,0,8,0" Foreground="White"/>
        <TextBlock Text="IHEC BookZone" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
      </StackPanel>
      
      <!-- Center navigation menu -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Button Content="Home" Command="{Binding NavigateToHomeCommand}" 
                Background="Transparent" Foreground="White" 
                Padding="12,8" Margin="5,0" CornerRadius="4"/>
        <Button Content="Library" Command="{Binding NavigateToLibraryCommand}" 
                Background="Transparent" Foreground="White" 
                Padding="12,8" Margin="5,0" CornerRadius="4"/>
        <Button Content="Profile" Command="{Binding NavigateToProfileCommand}" 
                Background="White" Foreground="{StaticResource PrimaryBrush}" 
                Padding="12,8" Margin="5,0" CornerRadius="4"/>
        <Button Content="Contact" 
                Background="Transparent" Foreground="White" 
                Padding="12,8" Margin="5,0" CornerRadius="4"/>
      </StackPanel>
      
      <!-- Right side: Search and profile -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
        <Button Content="Ask" Padding="12,5" Margin="0,0,15,0" 
                Background="Transparent" Foreground="White" 
                BorderBrush="White" BorderThickness="1" CornerRadius="4"/>
        <Border CornerRadius="50" Width="32" Height="32" ClipToBounds="True" 
                Margin="0,0,8,0" Background="#F0F2F5">
          <Image Source="{Binding UserProfilePicture}" Stretch="UniformToFill"/>
        </Border>
      </StackPanel>
    </Grid>
    
    <!-- Contenu principal -->
    <Grid Grid.Row="1">
      <!-- Error message display with updated styling -->
      <Border Background="#FFF3F3" Padding="20" IsVisible="{Binding HasError}" Margin="20" CornerRadius="8" BorderBrush="#FFCDD2" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Une erreur est survenue" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" Foreground="#D32F2F"/>
          <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#D32F2F" Margin="0,0,0,15"/>
          
          <!-- Description of possible solutions -->
          <TextBlock Text="Voici quelques solutions à essayer:" Foreground="#555555" Margin="0,0,0,10"/>
          
          <!-- Action buttons with class styling -->
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Réessayer" Command="{Binding RefreshProfileCommand}" 
                    Classes="primary" 
                    Padding="15,8" Margin="0,0,10,0"/>
            
            <Button Content="Connexion" Command="{Binding NavigateToLoginCommand}" 
                    Classes="secondary" 
                    Padding="15,8" Margin="10,0,10,0"/>
            
            <Button Content="Accueil" Command="{Binding NavigateToHomeCommand}" 
                    Classes="accent" 
                    Padding="15,8" Margin="10,0,0,0"/>
          </StackPanel>
          
          <TextBlock Text="Si le problème persiste, veuillez contacter le support ou redémarrer l'application." 
                     Foreground="#555555" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>
      </Border>
      
      <!-- Loading indicator -->
      <Border Background="#80FFFFFF" IsVisible="{Binding IsLoading}" ZIndex="100">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <ProgressBar IsIndeterminate="True" Width="100" Height="4" Margin="0,0,0,10"/>
          <TextBlock Text="Chargement du profil..." FontSize="14" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
      
      <!-- Main content when not loading and no errors -->
      <ScrollViewer Padding="40" Background="White" IsVisible="{Binding !HasError}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          
          <!-- User profile section -->
          <StackPanel Grid.Column="0" Margin="0,0,40,0">
            <Border Classes="card" Padding="20">
              <StackPanel>
                <Border CornerRadius="100" Width="150" Height="150" ClipToBounds="True" HorizontalAlignment="Center" Margin="0,0,0,20">
                  <Image Source="{Binding UserProfilePicture}" Stretch="UniformToFill"/>
                </Border>
                
                <TextBlock Text="{Binding UserFullName}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,5" Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Text="{Binding UserEmail}" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,20" Opacity="0.7"/>
                
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,0,0,20">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Téléphone:" FontWeight="SemiBold" Margin="0,0,10,10"/>
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding UserPhone}" Margin="0,0,0,10"/>
                  
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Niveau:" FontWeight="SemiBold" Margin="0,0,10,10"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UserLevel}" Margin="0,0,0,10"/>
                  
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Domaine:" FontWeight="SemiBold" Margin="0,0,10,10"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UserField}" Margin="0,0,0,10"/>
                  
                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Rang:" FontWeight="SemiBold" Margin="0,0,10,10"/>
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding UserRank}" FontWeight="Bold" Margin="0,0,0,10" Foreground="{StaticResource PrimaryBrush}"/>
                </Grid>
                
                <Button Content="Modifier le profil" Command="{Binding EditProfileCommand}" 
                        Classes="primary" 
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Height="40" Margin="0,0,0,10"/>
                
                <Button Content="Déconnexion" Command="{Binding SignOutCommand}" 
                        Classes="secondary" 
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Height="40"/>
              </StackPanel>
            </Border>
          </StackPanel>
          
          <!-- Statistics and activities -->
          <StackPanel Grid.Column="1">
            <!-- Statistics overview -->
            <Grid ColumnDefinitions="*,*,*" Margin="0,0,0,30">
              <Border Grid.Column="0" Classes="card" Margin="0,0,10,0" Background="#f0f7fd">
                <StackPanel>
                  <TextBlock Text="{Binding BorrowedBooksCount}" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
                  <TextBlock Text="Livres empruntés" FontSize="14" HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>
              
              <Border Grid.Column="1" Classes="card" Margin="10,0,10,0" Background="#f5f5f5">
                <StackPanel>
                  <TextBlock Text="{Binding ReservedBooksCount}" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
                  <TextBlock Text="Livres réservés" FontSize="14" HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>
              
              <Border Grid.Column="2" Classes="card" Margin="10,0,0,0" Background="#f0f9f0">
                <StackPanel>
                  <TextBlock Text="{Binding LikedBooksCount}" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
                  <TextBlock Text="Livres favoris" FontSize="14" HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>
            </Grid>
            
            <!-- Ranking system card -->
            <Border Classes="card" Margin="0,0,0,30">
              <StackPanel>
                <TextBlock Text="Système de classement des lecteurs" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Text="Progressez dans les rangs en empruntant plus de livres à la bibliothèque" FontSize="14" Margin="0,0,0,20" Opacity="0.7"/>
                
                <Grid ColumnDefinitions="*,*,*,*">
                  <!-- Bronze rank -->
                  <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <Canvas Width="60" Height="60">
                      <Ellipse Canvas.Left="5" Canvas.Top="5" Width="50" Height="50" Fill="#CD7F32" />
                      <Path Canvas.Left="18" Canvas.Top="15" 
                            Data="M12,2 L15.09,8.45 L22,9.82 L16.91,14.77 L18.27,21.6 L12,18.32 L5.72,21.6 L7.09,14.77 L2,9.82 L8.91,8.45 Z" 
                            Fill="White" Stroke="#966023" StrokeThickness="1" />
                    </Canvas>
                    <Border Background="#CD7F32" CornerRadius="15" Padding="10,5" Margin="0,10,0,5">
                      <TextBlock Text="Bronze" Foreground="#333333" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="&lt; 2 livres" FontSize="12" HorizontalAlignment="Center" Foreground="#333333" FontWeight="SemiBold"/>
                  </StackPanel>
                  
                  <!-- Silver rank -->
                  <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <Canvas Width="60" Height="60">
                      <Ellipse Canvas.Left="5" Canvas.Top="5" Width="50" Height="50" Fill="#C0C0C0" />
                      <Path Canvas.Left="18" Canvas.Top="15" 
                            Data="M12,2 L15.09,8.45 L22,9.82 L16.91,14.77 L18.27,21.6 L12,18.32 L5.72,21.6 L7.09,14.77 L2,9.82 L8.91,8.45 Z" 
                            Fill="White" Stroke="#A0A0A0" StrokeThickness="1" />
                    </Canvas>
                    <Border Background="#C0C0C0" CornerRadius="15" Padding="10,5" Margin="0,10,0,5">
                      <TextBlock Text="Argent" Foreground="#333333" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="2-4 livres" FontSize="12" HorizontalAlignment="Center" Foreground="#333333" FontWeight="SemiBold"/>
                  </StackPanel>
                  
                  <!-- Gold rank -->
                  <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <Canvas Width="60" Height="60">
                      <Ellipse Canvas.Left="5" Canvas.Top="5" Width="50" Height="50" Fill="#FFD700" />
                      <Path Canvas.Left="18" Canvas.Top="15" 
                            Data="M12,2 L15.09,8.45 L22,9.82 L16.91,14.77 L18.27,21.6 L12,18.32 L5.72,21.6 L7.09,14.77 L2,9.82 L8.91,8.45 Z" 
                            Fill="White" Stroke="#DAA520" StrokeThickness="1" />
                    </Canvas>
                    <Border Background="#FFD700" CornerRadius="15" Padding="10,5" Margin="0,10,0,5">
                      <TextBlock Text="Or" Foreground="#333333" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="5-10 livres" FontSize="12" HorizontalAlignment="Center" Foreground="#333333" FontWeight="SemiBold"/>
                  </StackPanel>
                  
                  <!-- Master rank -->
                  <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <Canvas Width="60" Height="60">
                      <Ellipse Canvas.Left="5" Canvas.Top="5" Width="50" Height="50" Fill="{StaticResource PrimaryBrush}" />
                      <Path Canvas.Left="18" Canvas.Top="15" 
                            Data="M12,2 L15.09,8.45 L22,9.82 L16.91,14.77 L18.27,21.6 L12,18.32 L5.72,21.6 L7.09,14.77 L2,9.82 L8.91,8.45 Z" 
                            Fill="White" Stroke="#102a70" StrokeThickness="1" />
                      <Ellipse Canvas.Left="20" Canvas.Top="20" Width="20" Height="20" Fill="{StaticResource PrimaryBrush}" Stroke="White" StrokeThickness="1" />
                    </Canvas>
                    <Border Background="{StaticResource PrimaryBrush}" CornerRadius="15" Padding="10,5" Margin="0,10,0,5">
                      <TextBlock Text="Master" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="&gt; 10 livres" FontSize="12" HorizontalAlignment="Center" Foreground="#333333" FontWeight="SemiBold"/>
                  </StackPanel>
                </Grid>
                
                <StackPanel Margin="0,20,0,0">
                  <TextBlock Text="Votre progression actuelle" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{StaticResource PrimaryBrush}"/>
                  <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto">
                    <ProgressBar Grid.Row="0" Grid.ColumnSpan="4" Value="{Binding ProgressValue}" Maximum="100" Height="10" Margin="0,0,0,5" Foreground="{StaticResource PrimaryBrush}"/>
                    
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Bronze" FontSize="12" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Argent" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Or" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Master" FontSize="12" HorizontalAlignment="Right"/>
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Border>
            
            <!-- Borrowed books section -->
            <Border Classes="card" Margin="0,0,0,30">
              <StackPanel>
                <TextBlock Text="Livres actuellement empruntés" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15" Foreground="{StaticResource PrimaryBrush}"/>
                
                <ItemsControl ItemsSource="{Binding BorrowedBooks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BorrowedBookViewModel">
                      <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,15">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <!-- Book cover -->
                          <Border Grid.Column="0" Width="50" Height="70" CornerRadius="4" ClipToBounds="True" Margin="0,0,15,0">
                            <Image Source="{Binding CoverImageUrl}" Stretch="UniformToFill"/>
                          </Border>
                          
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16"/>
                            <TextBlock Text="{Binding Author}" FontSize="14" Margin="0,5,0,0" Opacity="0.7"/>
                            <TextBlock Text="{Binding DueDate}" Foreground="{StaticResource PrimaryBrush}" FontSize="12" Margin="0,5,0,0"/>
                          </StackPanel>
                          
                          <Button Grid.Column="2" Content="Retourner" Command="{Binding ReturnCommand}" 
                                  Classes="primary" 
                                  VerticalAlignment="Center" Padding="15,8"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <!-- Show message when no borrowed books -->
                <TextBlock Text="Vous n'avez pas de livres empruntés actuellement" 
                          IsVisible="{Binding !BorrowedBooks.Count}" 
                          Opacity="0.7" HorizontalAlignment="Center" Margin="0,15,0,0"/>
              </StackPanel>
            </Border>
            
            <!-- Reserved books section -->
            <Border Classes="card">
              <StackPanel>
                <TextBlock Text="Livres réservés" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15" Foreground="{StaticResource PrimaryBrush}"/>
                
                <ItemsControl ItemsSource="{Binding ReservedBooks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReservedBookViewModel">
                      <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,15">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <!-- Book cover -->
                          <Border Grid.Column="0" Width="50" Height="70" CornerRadius="4" ClipToBounds="True" Margin="0,0,15,0">
                            <Image Source="{Binding CoverImageUrl}" Stretch="UniformToFill"/>
                          </Border>
                          
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16"/>
                            <TextBlock Text="{Binding Author}" FontSize="14" Margin="0,5,0,0" Opacity="0.7"/>
                            <TextBlock Text="{Binding ReservationStatus}" Foreground="{StaticResource PrimaryBrush}" FontSize="12" Margin="0,5,0,0"/>
                          </StackPanel>
                          
                          <Button Grid.Column="2" Content="Annuler" Command="{Binding CancelCommand}" 
                                  Classes="secondary" 
                                  VerticalAlignment="Center" Padding="15,8"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <!-- Show message when no reserved books -->
                <TextBlock Text="Vous n'avez pas de livres réservés actuellement" 
                          IsVisible="{Binding !ReservedBooks.Count}" 
                          Opacity="0.7" HorizontalAlignment="Center" Margin="0,15,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>

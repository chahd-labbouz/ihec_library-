<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:IHECLibrary.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="IHECLibrary.Views.HomeView"
             x:DataType="vm:HomeViewModel">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    
    <!-- Top navigation bar in deeper blue -->
    <Grid Grid.Row="0" Background="{StaticResource PrimaryBrush}" Height="60">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      
      <!-- Logo and title -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
        <TextBlock Text="📚" FontSize="22" Margin="0,0,8,0" Foreground="White"/>
        <TextBlock Text="IHEC BookZone" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
      </StackPanel>
      
      <!-- Center navigation menu -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Button Content="Home" Command="{Binding NavigateToHomeCommand}" 
                Background="Transparent" Foreground="White" 
                Padding="12,8" Margin="5,0" CornerRadius="4"/>
        <Button Content="Library" Command="{Binding NavigateToLibraryCommand}" 
                Background="Transparent" Foreground="White" 
                Padding="12,8" Margin="5,0" CornerRadius="4"/>
        <Button Content="Profile" Command="{Binding NavigateToProfileCommand}" 
                Background="Transparent" Foreground="White" 
                Padding="12,8" Margin="5,0" CornerRadius="4"/>
      </StackPanel>
      
      <!-- Right side: Search and profile -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
        <Button Content="Ask" Command="{Binding NavigateToChatbotCommand}" Padding="12,5" Margin="0,0,15,0" 
                Background="White" Foreground="{StaticResource PrimaryBrush}" 
                BorderBrush="White" BorderThickness="1" CornerRadius="4"/>
        <Border CornerRadius="50" Width="32" Height="32" ClipToBounds="True" 
                Margin="0,0,8,0" Background="{StaticResource PrimaryBrush}">
          <Image Source="avares://IHECLibrary/Assets/balbouz.png" Stretch="UniformToFill"/>
        </Border>
      </StackPanel>
    </Grid>
    
    <!-- Main content -->
    <ScrollViewer Grid.Row="1" Padding="0" Background="White">
      <StackPanel>
        <!-- Welcome section -->
        <Grid Margin="0,0,0,30">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          
          <!-- White welcome area -->
          <StackPanel Grid.Row="0" Margin="40,30,40,0">
            <TextBlock Text="{Binding WelcomeMessage}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,10"/>
            
            <!-- Recommendations title -->
            <Grid Margin="0,20,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              
              <StackPanel Grid.Column="0">
                <TextBlock Text="Recommandations pour vous" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Text="Livres recommandés basés sur votre domaine d'étude: Finance" 
                           FontSize="14" Opacity="0.7" Margin="0,5,0,0"/>
              </StackPanel>
              
              <Button Grid.Column="1" Content="Voir plus de recommandations" Command="{Binding ViewAllRecommendationsCommand}" 
                      Classes="primary" VerticalAlignment="Top"/>
            </Grid>
          </StackPanel>
        </Grid>
        
        <!-- Book recommendations -->
        <ItemsControl ItemsSource="{Binding RecommendedBooks}" Margin="40,0,40,30">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:BookViewModel">
              <!-- Book card with soft shadow -->
              <Border Classes="card" Width="210" Height="340" Margin="0,0,20,20">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="180"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  
                  <!-- Book Cover Image in larger size -->
                  <Border Grid.Row="0" ClipToBounds="True" CornerRadius="6" Margin="0,0,0,10">
                    <Image Source="avares://IHECLibrary/Assets/book.png" Stretch="Uniform" Width="150" Height="180" HorizontalAlignment="Center"/>
                  </Border>
                  
                  <!-- Book Title -->
                  <TextBlock Grid.Row="1" Text="{Binding Title}" 
                             FontWeight="SemiBold" FontSize="15" 
                             HorizontalAlignment="Left" TextWrapping="Wrap" 
                             MaxHeight="45" TextTrimming="CharacterEllipsis"/>
                  
                  <!-- Author -->
                  <TextBlock Grid.Row="2" Text="{Binding Author}" 
                             FontSize="13" Opacity="0.8"
                             HorizontalAlignment="Left" Margin="0,5,0,0"/>
                  
                  <!-- Rating stars -->
                  <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="★★★★★" Foreground="#FFD700" FontSize="14"/>
                    <TextBlock Text="4.5" Margin="5,0,0,0" FontSize="13" Opacity="0.7"/>
                  </StackPanel>
                  
                  <!-- Action buttons -->
                  <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Emprunter" Classes="primary"
                            HorizontalAlignment="Left" Padding="12,6" Margin="0,0,8,0"/>
                    <Button Content="Détails"
                            Classes="secondary" 
                            HorizontalAlignment="Left" Padding="12,6"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        
        <!-- Categories section -->
        <StackPanel Margin="40,0,40,30">
          <TextBlock Text="Explorer par catégorie" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15" Foreground="{StaticResource PrimaryBrush}"/>
          
          <WrapPanel>
            <Border Classes="card" Width="180" Height="120" Margin="0,0,15,15" Background="#e6f2ff">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Finance" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Text="120 livres" FontSize="13" HorizontalAlignment="Center" Opacity="0.7" Margin="0,5,0,0"/>
              </StackPanel>
            </Border>
            
            <Border Classes="card" Width="180" Height="120" Margin="0,0,15,15" Background="#fff2e6">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Marketing" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Text="58 livres" FontSize="13" HorizontalAlignment="Center" Opacity="0.7" Margin="0,5,0,0"/>
              </StackPanel>
            </Border>
            
            <Border Classes="card" Width="180" Height="120" Margin="0,0,15,15" Background="#e6ffe6">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Gestion" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Text="142 livres" FontSize="13" HorizontalAlignment="Center" Opacity="0.7" Margin="0,5,0,0"/>
              </StackPanel>
            </Border>
            
            <Border Classes="card" Width="180" Height="120" Margin="0,0,15,15" Background="#f2e6ff">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Big Data" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Text="65 livres" FontSize="13" HorizontalAlignment="Center" Opacity="0.7" Margin="0,5,0,0"/>
              </StackPanel>
            </Border>
            
            <Border Classes="card" Width="180" Height="120" Margin="0,0,15,15" Background="#ffe6e6">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Comptabilité" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Text="87 livres" FontSize="13" HorizontalAlignment="Center" Opacity="0.7" Margin="0,5,0,0"/>
              </StackPanel>
            </Border>
          </WrapPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

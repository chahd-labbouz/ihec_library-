<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:IHECLibrary.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="IHECLibrary.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    
    <!-- Barre de navigation -->
    <Grid Grid.Row="0" Background="{StaticResource PrimaryBrush}" Height="60">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      
      <!-- Logo and title -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
        <TextBlock Text="📚" FontSize="22" Margin="0,0,8,0" Foreground="White"/>
        <TextBlock Text="IHEC BookZone" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
      </StackPanel>
      
      <!-- Center navigation menu -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Button Content="Home" Command="{Binding NavigateToHomeCommand}" 
                Background="Transparent" Foreground="White" 
                Padding="12,8" Margin="5,0" CornerRadius="4"/>
        <Button Content="Library" Command="{Binding NavigateToLibraryCommand}" 
                Background="White" Foreground="{StaticResource PrimaryBrush}" 
                Padding="12,8" Margin="5,0" CornerRadius="4"/>
        <Button Content="Profile" Command="{Binding NavigateToProfileCommand}" 
                Background="Transparent" Foreground="White" 
                Padding="12,8" Margin="5,0" CornerRadius="4"/>
        <Button Content="Contact" 
                Background="Transparent" Foreground="White" 
                Padding="12,8" Margin="5,0" CornerRadius="4"/>
      </StackPanel>
      
      <!-- Right side: Search and profile -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
        <Button Content="Ask" Padding="12,5" Margin="0,0,15,0" 
                Background="Transparent" Foreground="White" 
                BorderBrush="White" BorderThickness="1" CornerRadius="4"/>
        <Border CornerRadius="50" Width="32" Height="32" ClipToBounds="True" 
                Margin="0,0,8,0" Background="#F0F2F5">
          <Image Source="{Binding UserProfilePicture}" Stretch="UniformToFill"/>
        </Border>
      </StackPanel>
    </Grid>
    
    <!-- Contenu principal -->
    <Grid Grid.Row="1" Background="White">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      
      <!-- Filtres -->
      <Border Grid.Column="0" Background="{StaticResource SecondaryBrush}" Padding="20">
        <StackPanel>
          <TextBlock Text="Filtres" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20" Foreground="{StaticResource PrimaryBrush}"/>
          
          <!-- Catégories -->
          <TextBlock Text="Catégories" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{StaticResource PrimaryBrush}"/>
          <ItemsControl ItemsSource="{Binding Categories}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CategoryViewModel">
                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,5,0,5" 
                         Foreground="{StaticResource TextBrush}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          
          <!-- Disponibilité -->
          <TextBlock Text="Disponibilité" FontWeight="SemiBold" Margin="0,20,0,10" Foreground="{StaticResource PrimaryBrush}"/>
          <RadioButton Content="Disponibles" IsChecked="{Binding IsAvailableOnly}" GroupName="Availability" Margin="0,5,0,5" 
                      Foreground="{StaticResource TextBrush}"/>
          <RadioButton Content="Tous" IsChecked="{Binding !IsAvailableOnly}" GroupName="Availability" Margin="0,5,0,5" 
                      Foreground="{StaticResource TextBrush}"/>
          
          <!-- Langue -->
          <TextBlock Text="Langue" FontWeight="SemiBold" Margin="0,20,0,10" Foreground="{StaticResource PrimaryBrush}"/>
          <ItemsControl ItemsSource="{Binding Languages}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LanguageViewModel">
                <RadioButton Content="{Binding Name}" IsChecked="{Binding IsSelected}" GroupName="Language" Margin="0,5,0,5" 
                            Foreground="{StaticResource TextBrush}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          
          <!-- Bouton d'application des filtres -->
          <Button Content="Appliquer les filtres" Command="{Binding ApplyFiltersCommand}" 
                  Classes="primary" 
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Height="40" Margin="0,20,0,0"/>
        </StackPanel>
      </Border>
      
      <!-- Liste des livres -->
      <Grid Grid.Column="1" Margin="30,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- En-tête avec titre et tri -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          
          <TextBlock Grid.Column="0" Text="{Binding PageTitle}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
          
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Trier par:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox SelectedItem="{Binding SelectedSortOption}" ItemsSource="{Binding SortOptions}" Width="150">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="sys:String">
                  <TextBlock Text="{Binding}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </Grid>
        
        <!-- Grille de livres -->
        <ScrollViewer Grid.Row="1">
          <Panel>
            <ItemsControl ItemsSource="{Binding Books}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BookViewModel">
                  <!-- Book card with soft shadow -->
                  <Border Classes="card" Width="210" Height="340" Margin="0,0,20,20">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="180"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                      </Grid.RowDefinitions>
                      
                      <!-- Book Cover Image in larger size -->
                      <Border Grid.Row="0" ClipToBounds="True" CornerRadius="6" Margin="0,0,0,10">
                        <Image Source="{Binding CoverImageUrl}" Stretch="Uniform" Width="150" Height="180" HorizontalAlignment="Center"/>
                      </Border>
                      
                      <!-- Book Title -->
                      <TextBlock Grid.Row="1" Text="{Binding Title}" 
                                 FontWeight="SemiBold" FontSize="15" 
                                 HorizontalAlignment="Left" TextWrapping="Wrap" 
                                 MaxHeight="45" TextTrimming="CharacterEllipsis"/>
                      
                      <!-- Author -->
                      <TextBlock Grid.Row="2" Text="{Binding Author}" 
                                 FontSize="13" Opacity="0.8"
                                 HorizontalAlignment="Left" Margin="0,5,0,0"/>
                      
                      <!-- Category with nicer styling -->
                      <Border Grid.Row="3" Background="#f0f4f8" CornerRadius="4" Padding="8,4" Margin="0,8,0,0" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Category}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource PrimaryBrush}"/>
                      </Border>
                      
                      <!-- Action buttons -->
                      <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="{Binding IsAvailable, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Emprunter,Réserver'}" 
                                Command="{Binding ActionCommand}"
                                Classes="primary"
                                HorizontalAlignment="Left" Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="Détails"
                                Classes="secondary" 
                                HorizontalAlignment="Left" Padding="12,6"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            
            <!-- Loading overlay -->
            <Border Background="#80FFFFFF" IsVisible="{Binding IsLoading}">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="100" Height="4" Margin="0,0,0,10"/>
                <TextBlock Text="Chargement des livres..." FontSize="14" HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>
          </Panel>
        </ScrollViewer>
        
        <!-- Pagination controls -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
          <Button Content="&lt; Précédent" 
                 Command="{Binding PreviousPageCommand}" 
                 IsEnabled="{Binding HasPreviousPage}"
                 Classes="primary"
                 Padding="15,8" Margin="5,0"/>
          
          <Border Background="{StaticResource SecondaryBrush}" CornerRadius="4" Padding="15,8" Margin="10,0">
            <TextBlock VerticalAlignment="Center">
              <TextBlock.Text>
                <MultiBinding StringFormat="Page {0} sur {1}">
                  <Binding Path="CurrentPage" />
                  <Binding Path="TotalPages" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
          </Border>
          
          <Button Content="Suivant &gt;" 
                 Command="{Binding NextPageCommand}" 
                 IsEnabled="{Binding HasNextPage}"
                 Classes="primary"
                 Padding="15,8" Margin="5,0"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
